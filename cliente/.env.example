# Copia este archivo como `.env` para desarrollo local.
#
# VITE_API_URL: URL base de la API Django, incluido el prefijo /api/v1.
#   Desarrollo:  http://127.0.0.1:8000/api/v1
#   Produccion:  https://api.tudominio.com/api/v1
#
# Vite solo expone al navegador las variables que empiezan con VITE_, por lo que
# cualquier dato escrito aqui es publico: nunca pongas secretos en este archivo.

VITE_API_URL=http://127.0.0.1:8000/api/v1
