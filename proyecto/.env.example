# Copia este archivo como `.env` y completa los valores reales.
# NO subas nunca el archivo `.env` al repositorio.
#
# Referencia de cada variable:
#
# DJANGO_SECRET_KEY
#   Clave secreta del proyecto. En produccion debe ser unica y aleatoria.
#   Generala con:
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# DJANGO_DEBUG
#   `True` solo en desarrollo. Con `False` Django deja de mostrar trazas de
#   error y aplica las protecciones de seguridad (HSTS, cookies seguras, etc.).
#
# DJANGO_ALLOWED_HOSTS
#   Lista separada por comas de los dominios que atienden el sitio.
#
# DJANGO_CORS_ALLOWED_ORIGINS
#   Origenes (esquema + host + puerto) autorizados a consumir la API desde un
#   navegador, es decir, donde correra la app cliente.
#
# DJANGO_CSRF_TRUSTED_ORIGINS
#   Origenes confiables para peticiones con verificacion CSRF, con esquema
#   incluido (por ejemplo https://app.midominio.com).

DJANGO_SECRET_KEY=cambia-esta-clave-por-una-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
